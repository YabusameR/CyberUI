{
  "name": "@fui-ui/react",
  "version": "3.0.0",
  "description": "SF/FUI-style React component library — HUD frames, holographic panels, boot sequences, data scramble and cinematic motion at 60fps.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/fui-ui.js",
  "module": "./dist/fui-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/fui-ui.js"
    },
    "./styles.css": "./dist/fui-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "19.2",
    "react-dom": "19.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^8.3.4"
  }
}
